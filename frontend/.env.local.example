# frontend/.env.local.example
#
# Ultra AutoTrade Dashboard - 環境変数テンプレート
#
# 使用方法:
#   1. このファイルを .env.local にコピー
#   2. Backend URL を実際の値に設定
#
# cp .env.local.example .env.local

# =============================================================================
# Backend API URL
# =============================================================================

# クライアントサイド（ブラウザから直接アクセス）
# CORS が有効な場合に使用（Backend 側で CORS ヘッダーが必要）
# この変数が設定されていると、ブラウザから直接 Backend に接続
NEXT_PUBLIC_BACKEND_BASE_URL=http://77.42.46.155:8000

# サーバーサイド（Next.js API Routes プロキシ用）
# CORS を回避するためのプロキシ経由で Backend に接続
# /api/automation/* へのリクエストを Backend にプロキシ
BACKEND_BASE_URL=http://77.42.46.155:8000

# =============================================================================
# 環境別設定例
# =============================================================================

# Hetzner Staging サーバ
# NEXT_PUBLIC_BACKEND_BASE_URL=http://77.42.46.155:8000
# BACKEND_BASE_URL=http://77.42.46.155:8000

# ローカル開発
# NEXT_PUBLIC_BACKEND_BASE_URL=http://localhost:8000
# BACKEND_BASE_URL=http://localhost:8000

# Docker Compose 内（フロントエンドもコンテナの場合）
# NEXT_PUBLIC_BACKEND_BASE_URL=http://backend:8000
# BACKEND_BASE_URL=http://backend:8000
