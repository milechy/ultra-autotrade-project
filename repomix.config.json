{
  "$schema": "https://repomix.com/schemas/latest/schema.json",
  "input": {
    "maxFileSize": 5000000
  },
  "output": {
    "filePath": "repomix-output.xml",
    "style": "xml",
    "showLineNumbers": true,
    "fileSummary": true,
    "directoryStructure": true,
    "files": true,
    "removeComments": false,
    "topFilesLength": 20
  },
  "ignore": {
    "useGitignore": true,
    "useDefaultPatterns": true,
    "customPatterns": [
      "**/.env",
      "**/.env.*",
      "**/*.key",
      "**/*.pem",
      "**/*.p12",
      "**/*.keystore",
      "**/secrets/**",
      "**/node_modules/**",
      "**/__pycache__/**",
      "**/.venv/**",
      "**/venv/**",
      "**/*.pyc",
      "**/migrations/versions/**",
      "**/alembic/versions/**",
      "**/*.lock",
      "**/package-lock.json",
      "**/dist/**",
      "**/.next/**",
      "**/build/**",
      "**/playwright-report/**",
      "**/test-results/**",
      "**/*.log",
      "**/repomix-output.xml"
    ]
  },
  "tokenCount": {
    "encoding": "o200k_base"
  },
  "security": {
    "enableSecurityCheck": true
  }
}
