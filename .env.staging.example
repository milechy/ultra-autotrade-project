# Ultra AutoTrade — Staging Environment Variables
# Copy to .env.staging and fill in actual values
# NEVER commit .env.staging to git!

# =============================================================================
# App
# =============================================================================
APP_ENV=staging
CORS_ORIGINS=https://staging.ultra-autotrade.com,http://localhost:3000

# =============================================================================
# Database (PostgreSQL + pgvector)
# =============================================================================
POSTGRES_USER=ultra
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=ultra_autotrade
# DATABASE_URL is set automatically in docker-compose.staging.yml
# For local dev: DATABASE_URL=postgresql://ultra:password@localhost:5432/ultra_autotrade

# =============================================================================
# AI / LLM
# =============================================================================
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# =============================================================================
# Exchange (Bybit Sandbox)
# =============================================================================
BYBIT_API_KEY=...
BYBIT_API_SECRET=...
BYBIT_SANDBOX=true

# =============================================================================
# Aave V3 (Sepolia Testnet)
# =============================================================================
AAVE_NETWORK=sepolia
AAVE_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY
AAVE_POOL_ADDRESS=0x...
AAVE_USDC_ADDRESS=0x...
AAVE_WALLET_PRIVATE_KEY=0x...TESTNET_ONLY...
AAVE_WALLET_ADDRESS=0x...PUBLIC_ADDRESS...
AAVE_CLIENT_TYPE=dummy
AAVE_MAX_SINGLE_TRADE_USD=10.0
AAVE_MIN_HEALTH_FACTOR=1.6
AAVE_STATE_FILE_PATH=/var/run/ultra/state.json

# =============================================================================
# Auth (JWT)
# =============================================================================
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=CHANGE_ME_RANDOM_SECRET
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# =============================================================================
# Monitoring & Notifications
# =============================================================================
ENABLE_BACKGROUND_MONITORING=1
ENABLE_DAILY_REPORTS=1
ENABLE_WEEKLY_REPORTS=1
MONITORING_INTERVAL_SECONDS=60
SLACK_WEBHOOK_URL=

# =============================================================================
# Exchange Client
# =============================================================================
EXCHANGE_CLIENT_TYPE=bybit

# =============================================================================
# フロントエンド（ビルド時に埋め込み、ランタイム変更不可）
# docker compose build 前に export が必要。docs/deploy_staging.md 参照。
# =============================================================================
NEXT_PUBLIC_BACKEND_BASE_URL=http://77.42.46.155:8000

# =============================================================================
# CORS（全アクセス元を列挙。Tunnel URL変更時は更新必須）
# =============================================================================
CORS_ORIGINS=https://<tunnel-url>.trycloudflare.com,http://77.42.46.155:3000,http://localhost:3000
