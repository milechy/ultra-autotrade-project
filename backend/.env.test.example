# ================================================
# Mumbai E2E Test Environment Variables
# ================================================
#
# このファイルは E2E テスト用の環境変数テンプレートです。
#
# 使用方法:
#   1. このファイルを .env.test にコピー
#      cp .env.test.example .env.test
#
#   2. 秘密鍵を設定
#      AAVE_WALLET_PRIVATE_KEY=0x...
#
#   3. テストを実行
#      source .env.test && pytest -m e2e -v
#
# ================================================
#
# ⚠️  セキュリティ警告:
#     - .env.test を絶対にコミットしないでください
#     - 秘密鍵を他人と共有しないでください
#     - 本番環境では使用しないでください
#     - 実際の資金をテストウォレットに送らないでください
#
# ================================================

# ----------------------------------------
# Wallet Configuration
# ----------------------------------------

# テストウォレットのアドレス
# 生成方法: python scripts/generate_test_wallet.py
AAVE_WALLET_ADDRESS=0x_YOUR_WALLET_ADDRESS_HERE

# テストウォレットの秘密鍵
# ⚠️ 絶対にコミットしないでください
# ⚠️ 本番ウォレットの秘密鍵を使用しないでください
AAVE_WALLET_PRIVATE_KEY=0x_YOUR_PRIVATE_KEY_HERE

# ----------------------------------------
# RPC Configuration
# ----------------------------------------

# Mumbai RPC エンドポイント
# 公開 RPC（レート制限あり）:
#   https://rpc-mumbai.maticvigil.com
#   https://polygon-mumbai.infura.io/v3/YOUR_PROJECT_ID
#
# Alchemy（推奨）:
#   https://polygon-mumbai.g.alchemy.com/v2/YOUR_API_KEY
#
# Infura:
#   https://polygon-mumbai.infura.io/v3/YOUR_PROJECT_ID
AAVE_RPC_URL=https://rpc-mumbai.maticvigil.com

# Chain ID（Mumbai = 80001）
AAVE_CHAIN_ID=80001

# ----------------------------------------
# Aave V3 Contract Addresses (Mumbai)
# ----------------------------------------

# Aave V3 Pool Address
# https://docs.aave.com/developers/deployed-contracts/v3-testnet-addresses
AAVE_POOL_ADDRESS=0x0b913A76beFF3887d35073b8e5530755D60F78C7

# Pool Addresses Provider
AAVE_POOL_ADDRESSES_PROVIDER=0x5343b5bA672Ae99d627A1C87866b8E53F47Db2E6

# Pool Data Provider
AAVE_POOL_DATA_PROVIDER=0x8f57153F18b7273f9A814b93b31Cb3f9b035e7C2

# ----------------------------------------
# Test Token Addresses (Mumbai)
# ----------------------------------------

# Test USDC Address
# Aave Faucet から取得可能: https://app.aave.com/faucet/
AAVE_USDC_ADDRESS=0x52D800ca262522580CeBAD275395ca6e7598C014

# Test WETH Address (optional)
AAVE_WETH_ADDRESS=0xc199807AF4fEDB02EE567Ed0FeB814A077de4802

# Test WMATIC Address (optional)
AAVE_WMATIC_ADDRESS=0xf237dE5664D3c2D2545684E76fef02A3A58A364c

# ----------------------------------------
# Test Configuration
# ----------------------------------------

# E2E テストを有効化
# 1: 有効, 0: 無効（デフォルト）
RUN_E2E_TESTS=1

# 統合テストを有効化（オプション）
RUN_INTEGRATION_TESTS=1

# クライアントタイプ
# dummy: モッククライアント（デフォルト）
# web3: 実際の Web3 クライアント
AAVE_CLIENT_TYPE=web3

# 運用モード
# NORMAL: 通常運用
# SAFE_MODE: 安全モード（deposit 禁止）
# HARD_STOP: 完全停止
AAVE_OPERATION_MODE=NORMAL

# ----------------------------------------
# Optional Configuration
# ----------------------------------------

# テスト用 deposit 金額（USDC, 6 decimals）
# デフォルト: 1.0 USDC
TEST_DEPOSIT_AMOUNT=1.0

# トランザクションタイムアウト（秒）
TX_TIMEOUT_SECONDS=120

# ガス価格の乗数（オプション）
# 1.0 = 通常, 1.5 = 50% 増し
GAS_PRICE_MULTIPLIER=1.2

# ----------------------------------------
# Faucet URLs (Reference)
# ----------------------------------------
#
# Mumbai MATIC Faucet（ガス代用）:
#   https://faucet.polygon.technology/
#
# Aave Test Token Faucet:
#   https://app.aave.com/faucet/
#
# ----------------------------------------

# ----------------------------------------
# PolygonScan (Reference)
# ----------------------------------------
#
# ウォレット確認:
#   https://mumbai.polygonscan.com/address/${AAVE_WALLET_ADDRESS}
#
# トランザクション確認:
#   https://mumbai.polygonscan.com/tx/${TX_HASH}
#
# ----------------------------------------
