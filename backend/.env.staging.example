# ============================================================
# backend/.env.staging.example — staging 環境変数テンプレート
# このファイルは Git 管理。実際の .env.staging は Git 管理外（.gitignore 対象）。
#
# デプロイ時の差分確認手順:
#   diff <(grep -v '^#' backend/.env.staging.example | grep '=' | cut -d= -f1 | sort) \
#        <(grep -v '^#' /opt/ultra-autotrade/.env.staging | grep '=' | cut -d= -f1 | sort)
# ============================================================

# ============================================================
# Docker Compose（必須）
# プロジェクト名が異なると別ネットワークになり DB 接続が 500 エラーになる
# ============================================================
COMPOSE_PROJECT_NAME=ultra-autotrade-project

# ============================================================
# Database（必須）
# ============================================================
POSTGRES_USER=ultra
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=ultra_autotrade
DATABASE_URL=postgresql://ultra:CHANGE_ME@postgres:5432/ultra_autotrade

# ============================================================
# JWT / Auth（必須）
# 生成: python -c "import secrets; print(secrets.token_urlsafe(64))"
# ============================================================
JWT_SECRET_KEY=CHANGE_ME_MIN_32_CHARS
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
APP_ENV=staging
INITIAL_ADMIN_EMAIL=admin@example.com
# POST /automation/process-news 等の内部APIに必要なトークン
# 生成: python -c "import secrets; print(secrets.token_urlsafe(32))"
INTERNAL_API_TOKEN=CHANGE_ME_GENERATE_WITH_secrets

# ============================================================
# AI API Keys（必須）
# ============================================================
ANTHROPIC_API_KEY=sk-ant-xxxxx
OPENAI_API_KEY=sk-xxxxx
PERPLEXITY_API_KEY=pplx-xxxxx
# Claude model names — must match VALID_CLAUDE_MODELS in backend/app/ai/config.py
AI_CLAUDE_MODEL=claude-sonnet-4-6
AI_FALLBACK_MODEL=claude-haiku-4-5-20251001

# AI モデル名（非推奨モデルは check_env_separation.sh で CI ブロック）
AI_CLAUDE_MODEL=claude-sonnet-4-6
AI_FALLBACK_MODEL=claude-haiku-4-5-20251001

# ============================================================
# Exchange（必須）
# ============================================================
BYBIT_API_KEY=xxxxx
BYBIT_API_SECRET=xxxxx

# ============================================================
# Aave 設定
# ============================================================
AAVE_ACTIVE_CHAINS=base_sepolia
AAVE_CLIENT_TYPE=web3
AAVE_NETWORK=base-sepolia
AAVE_RPC_URL=https://sepolia.base.org
# MultiChainAaveService 用 RPC URL（AAVE_ACTIVE_CHAINS で指定したチェーンに対応する変数を設定）
ALCHEMY_RPC_URL_BASE_SEPOLIA=https://sepolia.base.org
AAVE_WALLET_PRIVATE_KEY=0x...testnet_key_only...
AAVE_MAX_SINGLE_TRADE_USD=10.0
AAVE_MIN_HEALTH_FACTOR=1.6
AAVE_TRADE_COOLDOWN_SECONDS=600
AAVE_STATE_FILE_PATH=/var/run/ultra/state.json
# Chainlink feed staleness threshold (seconds). Base Sepolia USDC/USD (0xd30e2101)
# heartbeat ≈ 24h; 90000s = 25h includes a safety buffer. Default 3600s would
# spuriously HOLD on long-heartbeat feeds.
AAVE_ORACLE_STALENESS_THRESHOLD_SECONDS=90000
REBALANCE_SHADOW_MODE=true

# ============================================================
# Notifications（任意）
# ============================================================
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxxxx
LINE_CHANNEL_ACCESS_TOKEN=xxxxx
LINE_USER_ID=xxxxx

# ============================================================
# Cloudflare Tunnel（必須）
# ============================================================
CLOUDFLARE_TUNNEL_TOKEN=xxxxx
NEXT_PUBLIC_BACKEND_BASE_URL=https://api.ultra-auto-trade.com
BACKEND_BASE_URL=http://backend:8000
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=xxxxx
CORS_ORIGINS=https://app.ultra-auto-trade.com

# ============================================================
# AI Scheduler（デフォルト有効）
# 停止する場合のみ DISABLE_=1 を設定。コメントアウトのまま = 有効。
# 旧方式 ENABLE_=1 も引き続き動作（後方互換）。
# ============================================================
# DISABLE_AI_JUDGMENT_SCHEDULER=1   # コメントのまま = 有効
# DISABLE_BACKGROUND_MONITORING=1   # コメントのまま = 有効
AI_JUDGMENT_INTERVAL_HOURS=4
NEWS_INTERVAL_MINUTES=15
GEO_RISK_INTERVAL_MINUTES=30
FINANCE_INTERVAL_MINUTES=60
HOWL_INTERVAL_HOURS=6

# ============================================================
# Reports（任意）
# ============================================================
ENABLE_DAILY_REPORTS=1
# ENABLE_WEEKLY_REPORTS=1
# ENABLE_AI_JUDGMENT_SCHEDULER=1   # 旧方式（後方互換）—— 上記 DISABLE_ 方式を推奨

# ============================================================
# Frontend Build-time Variables (NEXT_PUBLIC_*)
# ============================================================
# These must also be in frontend/Dockerfile ARG + docker-compose build.args
# Missing any causes Mixed Content errors (2026-04-03 incident)
# NEXT_PUBLIC_API_BASE_URL=https://api.ultra-auto-trade.com
# NEXT_PUBLIC_API_URL=https://api.ultra-auto-trade.com
# NEXT_PUBLIC_BASE_RPC=https://mainnet.base.org
# NEXT_PUBLIC_BASE_SEPOLIA_RPC=https://sepolia.base.org
# NEXT_PUBLIC_ARBITRUM_ONE_RPC=https://arb1.arbitrum.io/rpc
# NEXT_PUBLIC_ARBITRUM_SEPOLIA_RPC=https://sepolia-rollup.arbitrum.io/rpc
# NEXT_PUBLIC_MAINNET_RPC=https://eth.llamarpc.com
# NEXT_PUBLIC_OPTIMISM_RPC=https://mainnet.optimism.io
# NEXT_PUBLIC_DEFAULT_CHAIN=base-sepolia
# NEXT_PUBLIC_DEFAULT_CHAIN_ID=84532
# NEXT_PUBLIC_LIFF_ID=（LINE Mini App有効化時に設定）
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=（WebPush有効化時に設定）

# F-S6: on-chain fee transfer (non-custodial pull model)
# operator 自身のウォレット。ユーザー鍵とは完全別変数。MaxUint256 approve 禁止。
FEE_TRANSFER_ENABLED=false
OPERATOR_FEE_WALLET_ADDRESS=0xCHANGE_ME_STAGING_OPERATOR_ADDRESS
OPERATOR_FEE_WALLET_KEY=0xCHANGE_ME_STAGING_OPERATOR_PRIVATE_KEY
