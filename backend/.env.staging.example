# backend/.env.staging.example
#
# Polygon Mumbai Testnet 用の環境変数テンプレート。
# 実際の値を設定する際は .env.staging にコピーして使用してください。
#
# 重要: .env.staging は Git にコミットしないでください（.gitignore 対象）

# =============================================================================
# Aave V3 (Polygon Mumbai Testnet)
# =============================================================================

# ネットワーク設定
AAVE_NETWORK=polygon-mumbai
AAVE_RPC_URL=https://rpc-mumbai.maticvigil.com

# Aave V3 コントラクトアドレス（Mumbai Testnet）
# https://docs.aave.com/developers/deployed-contracts/v3-testnet-addresses
AAVE_POOL_ADDRESS=0x6C9fB0D5bD9429eb9Cd96B85B81d872281771E6B
AAVE_POOL_DATA_PROVIDER_ADDRESS=0x8f57153F18b7273f9A814b93b31Cb3f9b035e7C2
AAVE_POOL_ADDRESSES_PROVIDER=0x5343b5bA672Ae99d627A1C87866b8E53F47Db2E6

# トークンアドレス（Mumbai Testnet）
AAVE_USDC_ADDRESS=0x9999f7Fea5938fD3b1E26A12c3f2fb024e194f97

# ウォレット設定（テストネット専用）
# 重要: 本番資金が入ったウォレットの秘密鍵は絶対に設定しないでください！
AAVE_WALLET_PRIVATE_KEY=0x...your_testnet_private_key_here...

# =============================================================================
# Aave 運用パラメータ
# =============================================================================

AAVE_DEFAULT_ASSET_SYMBOL=USDC
AAVE_MAX_SINGLE_TRADE_USD=10.0
AAVE_MIN_HEALTH_FACTOR=1.6
AAVE_WARN_HEALTH_FACTOR=1.8
AAVE_TRADE_COOLDOWN_SECONDS=600

# 動作モード: NORMAL / SAFE_MODE / HARD_STOP
AAVE_OPERATION_MODE=NORMAL

# state.json のパス
AAVE_STATE_FILE_PATH=/var/run/ultra/state.json
AAVE_STATE_STALE_THRESHOLD_SECONDS=300

# =============================================================================
# クライアント選択
# =============================================================================

# web3: Web3AaveClient（実クライアント）
# dummy: DummyAaveClient（テスト用ダミー）
AAVE_CLIENT_TYPE=web3

# 環境識別（staging / production / dev）
APP_ENV=staging

# =============================================================================
# JWT 認証 (Phase12)
# =============================================================================

# JWT シークレットキー（本番では必ず変更してください）
# 生成例: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=development-secret-key-change-in-production

# JWT アルゴリズム
JWT_ALGORITHM=HS256

# アクセストークン有効期限（分）: 24時間 = 1440分
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# =============================================================================
# Database (Phase12)
# =============================================================================

# SQLite データベースパス
DATABASE_URL=sqlite:///./data/users.db

# =============================================================================
# CORS 設定
# =============================================================================

# 許可するオリジン（カンマ区切り）
CORS_ORIGINS=http://localhost:3000,http://77.42.46.155:3000
