# backend/.env.production.example
#
# Ultra AutoTrade – Production 環境用 .env テンプレート
#
# ╔══════════════════════════════════════════════════════════════════════════════╗
# ║                            ⚠️  重要な警告  ⚠️                                ║
# ╠══════════════════════════════════════════════════════════════════════════════╣
# ║                                                                              ║
# ║  このファイルはテンプレートです。本物の秘密情報を書かないでください。        ║
# ║                                                                              ║
# ║  使用方法:                                                                   ║
# ║    1. cp .env.production.example .env.production                             ║
# ║    2. .env.production に実際の値を記入する                                   ║
# ║    3. chmod 600 .env.production                                              ║
# ║                                                                              ║
# ║  絶対に守ること:                                                             ║
# ║    - .env.production は Git にコミットしない（.gitignore 対象）               ║
# ║    - .env.staging の値をコピーして使い回さない                               ║
# ║    - staging と production は物理的に異なるキー・ウォレットを使用する        ║
# ║    - 秘密鍵・APIキーはログに出力しない（先頭6文字＋末尾4文字のみ許可）       ║
# ║                                                                              ║
# ║  参照ドキュメント:                                                           ║
# ║    docs/13_security_design.md  §1, §2                                        ║
# ║    docs/21_production_environment_config.md                                  ║
# ║                                                                              ║
# ╚══════════════════════════════════════════════════════════════════════════════╝

# =============================================================================
# App / Auth
# =============================================================================

# 環境種別（必須・固定値）
APP_ENV=production

# Phase 1 例外設定: この日付までは check_env_separation.sh が APP_ENV 等の staging 値を WARN に格下げ
# Phase 2 移行後に削除するか日付を更新すること
PHASE1_EXCEPTION_EXPIRES_ON=2026-09-30

# ログレベル（production は INFO 推奨）
LOG_LEVEL=INFO

# タイムゾーン（レポート・スケジュール基準）
APP_TIMEZONE=Asia/Tokyo

# CORS 許可オリジン（カンマ区切り。本番ドメインのみ許可すること）
CORS_ORIGINS=https://CHANGE_ME_PRODUCTION_DOMAIN

# -- JWT 設定 --
# ⚠️ JWT_SECRET_KEY は staging と必ず異なる値を使用すること
# 生成例: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=CHANGE_ME_STRONG_RANDOM_SECRET_64_CHARS_MINIMUM

# JWT アルゴリズム（変更不要）
JWT_ALGORITHM=HS256

# アクセストークン有効期限（分）: 1440 = 24時間
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ログインレート制限（形式: "回数/単位"）
LOGIN_RATE_LIMIT=5/minute

# 初期管理者アカウントのメールアドレス（初回起動時に自動作成）
INITIAL_ADMIN_EMAIL=CHANGE_ME_ADMIN_EMAIL@example.com

# =============================================================================
# Database (PostgreSQL)
# =============================================================================

# PostgreSQL 接続 URL（production では SQLite は使用しないこと）
# 形式: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql://CHANGE_ME_PG_USER:CHANGE_ME_PG_PASSWORD@CHANGE_ME_PG_HOST:5432/CHANGE_ME_PG_DB

# PostgreSQL 個別設定（DATABASE_URL と整合させること）
POSTGRES_USER=CHANGE_ME_PG_USER
POSTGRES_PASSWORD=CHANGE_ME_PG_PASSWORD
POSTGRES_DB=CHANGE_ME_PG_DB
POSTGRES_HOST=CHANGE_ME_PG_HOST
POSTGRES_PORT=5432

# SQLAlchemy クエリログ（production は false 推奨）
DATABASE_ECHO=false

# =============================================================================
# Aave V3 (Arbitrum One Mainnet)
# =============================================================================
# ⚠️ 本番資金が入ったウォレットを使用するため、秘密鍵の管理は最重要
# ⚠️ staging のウォレット秘密鍵を流用しないこと

# ETH/USD フォールバック価格（Chainlink price feed 取得失敗時に使用）
# デフォルト: 2100.00。実勢価格と大幅に乖離したら更新すること。
# 過大設定だとガス代 USD 推定が実態より高く見積もられ is_gas_cost_acceptable が誤拒否する。
ETH_USD_FALLBACK_PRICE=2100.00

# 有効チェーン（カンマ区切り。production は arbitrum を使用）
# テストネット使用時は base_sepolia を指定可（staging/shadow mode 専用）
AAVE_ACTIVE_CHAINS=arbitrum

# クライアント種別（production は必ず web3）
AAVE_CLIENT_TYPE=web3

# Arbitrum One RPC エンドポイント（Alchemy / Infura 推奨。公開 RPC は非推奨）
# 取得先: https://www.alchemy.com/ または https://www.infura.io/
AAVE_RPC_URL_ARBITRUM=https://arb-mainnet.g.alchemy.com/v2/CHANGE_ME_ALCHEMY_API_KEY

# Base Sepolia テストネット RPC（AAVE_ACTIVE_CHAINS=base_sepolia 時に必須）
# staging-new / shadow mode 専用。production では使用しないこと
# ALCHEMY_RPC_URL_BASE_SEPOLIA=https://base-sepolia.g.alchemy.com/v2/CHANGE_ME_ALCHEMY_API_KEY

# -- Aave V3 コントラクトアドレス (Arbitrum One – 変更不要) --
# 参照: https://docs.aave.com/developers/deployed-contracts/v3-mainnet/arbitrum-one
# Pool Proxy:
#   0x794a61358D6845594F94dc1DB02A252b5b4814aD
# ※ アドレスはチェーン定義ファイル (app/aave/chains.py) で管理。
# ※ 変更する場合は chains.py を更新すること。

# -- ウォレット設定 --
# ⚠️ 秘密鍵は環境変数のみで管理。ログ・コード・バージョン管理に含めないこと
AAVE_WALLET_PRIVATE_KEY=0xCHANGE_ME_PRODUCTION_WALLET_PRIVATE_KEY
AAVE_WALLET_ADDRESS=0xCHANGE_ME_PRODUCTION_WALLET_ADDRESS

# --- Fee Transfer (設計A: OPERATOR_FEE_WALLET_ADDRESS/_KEY を使用) ---
# FEE_TRANSFER_ENABLED=false はデフォルト。法務OK後に true に変更する (本番送金解禁)
# operator アドレス/鍵は OPERATOR_FEE_WALLET_ADDRESS / OPERATOR_FEE_WALLET_KEY を参照。
# (旧 FEE_RECIPIENT_ADDRESS = 設計B は 2026-07-05 に削除・設計Aへ統一)
FEE_TRANSFER_ENABLED=false
# aBasUSDC コントラクトアドレス (Base Mainnet: 0x4e65fE4DbA92790696d040ac24Aa414708F5c0Ab)
ATOKEN_USDC_BASE=0x4e65fE4DbA92790696d040ac24Aa414708F5c0Ab
# aBasUSDC コントラクトアドレス (Base Sepolia testnet)
ATOKEN_USDC_BASE_SEPOLIA=0xab067c01df6C68BE84ac60FA1cF81Ad1E2261Bd5
# fee allowance 上限 (USDC 単位 / デフォルト 1000 USDC)
FEE_ALLOWANCE_LIMIT_USDC=1000

# -- 運用パラメータ --
# デフォルト運用資産
AAVE_DEFAULT_ASSET_SYMBOL=USDC

# 1回の最大取引額（USD）: Security Rules §3「単一取引上限 10%」を守ること
AAVE_MAX_SINGLE_TRADE_USD=100.0

# Health Factor しきい値: Security Rules §2「HF < 1.6 で HARD_STOP」
AAVE_MIN_HEALTH_FACTOR=1.6
AAVE_WARN_HEALTH_FACTOR=1.8

# トレード間クールダウン（秒）: Security Rules §5「最低 10 分」
AAVE_TRADE_COOLDOWN_SECONDS=600

# 動作モード: NORMAL / SAFE_MODE / HARD_STOP
AAVE_OPERATION_MODE=NORMAL

# state.json パス（Docker volume マウント先）
AAVE_STATE_FILE_PATH=/var/run/ultra/state.json
AAVE_STATE_STALE_THRESHOLD_SECONDS=300

# Chainlink price feed staleness threshold (seconds).
# Base mainnet USDC/USD heartbeat ≈ 24h → 90000s (25h) with safety buffer.
# Override per chain/feed in production; default fallback (3600s) is unsafe
# for long-heartbeat stable-coin feeds and will spuriously HOLD trades.
AAVE_ORACLE_STALENESS_THRESHOLD_SECONDS=90000

# Rebalance Shadow Mode（production は false）
REBALANCE_SHADOW_MODE=false

# Rebalance API トークン（ランダム生成推奨）
REBALANCE_TOKEN_SECRET=CHANGE_ME_REBALANCE_TOKEN_SECRET

# リバランス目標配分（JSON形式。例: {"USDC":0.7,"WETH":0.3}）
# REBALANCE_TARGET_ALLOCATIONS={"USDC":0.7,"WETH":0.3}

# =============================================================================
# AI / LLM
# =============================================================================

# -- Anthropic (Claude) --
# 取得先: https://console.anthropic.com/
ANTHROPIC_API_KEY=CHANGE_ME_ANTHROPIC_API_KEY

# Claude モデル名（production は最新安定版を推奨）
# 許可リスト: backend/app/ai/config.py の VALID_CLAUDE_MODELS 参照
AI_CLAUDE_MODEL=claude-sonnet-4-6

# -- OpenAI (GPT-4o) --
# 取得先: https://platform.openai.com/
OPENAI_API_KEY=CHANGE_ME_OPENAI_API_KEY

# GPT モデル名
AI_OPENAI_MODEL=gpt-4o

# フォールバックモデル（Claude 障害時。primary と異なるモデルを指定すること）
AI_FALLBACK_MODEL=claude-haiku-4-5-20251001

# -- Perplexity (ニュース/マクロ分析) --
# 取得先: https://www.perplexity.ai/settings/api
PERPLEXITY_API_KEY=CHANGE_ME_PERPLEXITY_API_KEY

# -- AI 動作設定 --
# Shadow Mode: production は false（実際のトレード判定を実行）
AI_SHADOW_MODE=false

# クロスバリデーション（Claude + GPT-4o の二重確認）: production は true 推奨
AI_CROSS_VALIDATION_ENABLED=true

# プロンプトバージョン
AI_PROMPT_VERSION=v1

# Knowledge Hub 埋め込みモデル
KNOWLEDGE_EMBEDDING_MODEL=text-embedding-3-small

# AI 判定ログ保存ディレクトリ
JUDGMENT_LOG_DIR=/var/log/ultra-autotrade

# =============================================================================
# Exchange (Bybit primary / bitFlyer)
# =============================================================================
# ⚠️ staging と production は必ず異なる API キーを使用すること

# 使用取引所クライアント: bybit / bitflyer / okx / kraken / sandbox
EXCHANGE_CLIENT_TYPE=bybit

# -- Bybit --
# 取得先: https://www.bybit.com/user/api-management
BYBIT_API_KEY=CHANGE_ME_BYBIT_API_KEY
BYBIT_API_SECRET=CHANGE_ME_BYBIT_API_SECRET

# Sandbox モード: production は false（本番取引）
EXCHANGE_SANDBOX=false

# -- bitFlyer (バックアップ / 法定通貨入出金) --
# 取得先: https://lightning.bitflyer.com/developer
BITFLYER_API_KEY=CHANGE_ME_BITFLYER_API_KEY
BITFLYER_API_SECRET=CHANGE_ME_BITFLYER_API_SECRET

# -- 共通取引設定 --
# デフォルト取引ペア
EXCHANGE_DEFAULT_SYMBOL=BTC/USDT

# 1注文の最大 USD 額: Security Rules §3
EXCHANGE_MAX_ORDER_USD=100

# 1日の最大取引回数: Security Rules §4「日次上限 30%」
EXCHANGE_DAILY_TRADE_LIMIT=10

# USD/JPY レート（定期更新推奨）
USD_TO_JPY_RATE=150.0

# =============================================================================
# Notifications (Slack / LINE)
# =============================================================================

# -- Slack --
# Webhook URL: https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/CHANGE_ME/CHANGE_ME/CHANGE_ME

# Slack Signing Secret（Claude Code hooks 承認ゲートで使用）
SLACK_SIGNING_SECRET=CHANGE_ME_SLACK_SIGNING_SECRET

# -- LINE Notify --
# トークン: https://notify-bot.line.me/my/
LINE_NOTIFY_TOKEN=CHANGE_ME_LINE_NOTIFY_TOKEN

# LINE Messaging API（プッシュ通知用）
LINE_CHANNEL_ACCESS_TOKEN=CHANGE_ME_LINE_CHANNEL_ACCESS_TOKEN
LINE_USER_ID=CHANGE_ME_LINE_USER_ID

# デフォルト通知チャンネル: line / slack / internal_log
NOTIFICATION_CHANNEL=slack

# -- Web Push (VAPID) --
# 生成例: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=CHANGE_ME_VAPID_PUBLIC_KEY
VAPID_PRIVATE_KEY=CHANGE_ME_VAPID_PRIVATE_KEY
VAPID_MAILTO=mailto:CHANGE_ME_ADMIN_EMAIL@example.com

# =============================================================================
# Cloudflare / Domain
# =============================================================================

# Cloudflare Tunnel 経由のバックエンド公開 URL
BACKEND_PUBLIC_URL=https://api.CHANGE_ME_PRODUCTION_DOMAIN

# フロントエンド公開 URL（CORS 許可リストと一致させること）
FRONTEND_URL=https://CHANGE_ME_PRODUCTION_DOMAIN

# =============================================================================
# Background Tasks / Schedulers
# =============================================================================

# バックグラウンド Aave 監視（production は 1）
ENABLE_BACKGROUND_MONITORING=1
MONITORING_INTERVAL_SECONDS=60

# 日次レポート自動生成（production は 1）
ENABLE_DAILY_REPORTS=1

# 週次レポート自動生成
ENABLE_WEEKLY_REPORTS=1

# AI 判定スケジューラー（4時間ごとに自動実行）
ENABLE_AI_JUDGMENT_SCHEDULER=1
AI_JUDGMENT_INTERVAL_HOURS=4

# =============================================================================
# Data Feeds (外部データ取得間隔)
# =============================================================================

# 地政学リスクスコア更新間隔（分）
GEO_RISK_INTERVAL_MINUTES=30

# ニュース取得間隔（分）
NEWS_INTERVAL_MINUTES=15

# 金融指標取得間隔（分）
FINANCE_INTERVAL_MINUTES=60

# HOWL レビュー間隔（時間）
HOWL_INTERVAL_HOURS=6

# =============================================================================
# Monitoring / Metrics
# =============================================================================

# ヘルスチェック URL（外形監視ツールから参照）
MONITOR_HEALTHCHECK_URL=https://api.CHANGE_ME_PRODUCTION_DOMAIN/health

# レイテンシ警告・アラートしきい値（ミリ秒）
MONITOR_WARN_MS=1000
MONITOR_ALERT_MS=30000

# メトリクスログディレクトリ
METRICS_LOG_DIR=/var/log/ultra

# 監視通知チャンネル名（論理名）
MONITOR_NOTIFY_CHANNEL=production-monitoring

# F-S6: on-chain fee transfer (non-custodial pull model)
# operator 自身のウォレット。ユーザー鍵・AAVE_WALLET_PRIVATE_KEY と完全別変数。MaxUint256 approve 禁止。
FEE_TRANSFER_ENABLED=false
OPERATOR_FEE_WALLET_ADDRESS=0xCHANGE_ME_PRODUCTION_OPERATOR_ADDRESS
OPERATOR_FEE_WALLET_KEY=0xCHANGE_ME_PRODUCTION_OPERATOR_PRIVATE_KEY
