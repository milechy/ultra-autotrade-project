# backend/.env.production.example
#
# Ultra AutoTrade – Production 環境用 .env テンプレート
#
# ╔══════════════════════════════════════════════════════════════════════════════╗
# ║                            ⚠️  重要な警告  ⚠️                                 ║
# ╠══════════════════════════════════════════════════════════════════════════════╣
# ║                                                                              ║
# ║  このファイルはテンプレートです。本物の秘密情報を書かないでください          ║
# ║                                                                              ║
# ║  使用方法:                                                                   ║
# ║  1. このファイルを .env.production にコピー                                  ║
# ║  2. .env.production に実際の値を設定                                         ║
# ║  3. chmod 600 .env.production で権限を制限                                   ║
# ║                                                                              ║
# ║  .env.production は絶対に Git にコミットしないでください                     ║
# ║                                                                              ║
# ╚══════════════════════════════════════════════════════════════════════════════╝

# =============================================================================
# Core / 共通設定
# =============================================================================

# 環境種別（必須）
APP_ENV=production

# ログレベル
LOG_LEVEL=INFO

# タイムゾーン（レポート生成用）
APP_TIMEZONE=Asia/Tokyo

# =============================================================================
# Aave V3 (Polygon Mainnet)
# =============================================================================

# ネットワーク設定
AAVE_NETWORK=polygon
AAVE_CHAIN_ID=137

# RPC エンドポイント（Alchemy/Infura 推奨）
# 公開 RPC は本番環境では推奨しません
AAVE_RPC_URL=https://polygon-mainnet.g.alchemy.com/v2/YOUR_API_KEY

# Aave V3 コントラクトアドレス（Polygon Mainnet）
# https://docs.aave.com/developers/deployed-contracts/v3-mainnet/polygon
AAVE_POOL_ADDRESS=0x794a61358D6845594F94dc1DB02A252b5b4814aD
AAVE_POOL_DATA_PROVIDER_ADDRESS=0x69FA688f1Dc47d4B5d8029D5a35FB7a548310654
AAVE_POOL_ADDRESSES_PROVIDER=0xa97684ead0e402dC232d5A977953DF7ECBaB3CDb

# トークンアドレス（Polygon Mainnet USDC）
AAVE_USDC_ADDRESS=0x2791Bca1f2de4661ED88A30C99A7a9449Aa84174

# =============================================================================
# ウォレット設定
# ⚠️ 秘密鍵は絶対にコミットしないでください
# =============================================================================

# 本番専用ウォレットの秘密鍵
AAVE_WALLET_PRIVATE_KEY=0x...YOUR_PRODUCTION_PRIVATE_KEY_HERE...

# ウォレットアドレス（検証用、任意）
AAVE_WALLET_ADDRESS=0x...YOUR_WALLET_ADDRESS_HERE...

# =============================================================================
# Aave 運用パラメータ
# =============================================================================

# デフォルト運用資産
AAVE_DEFAULT_ASSET_SYMBOL=USDC

# 1回の最大取引額（USD）
# 本番では慎重な値を設定
AAVE_MAX_SINGLE_TRADE_USD=100.0

# ヘルスファクターしきい値
AAVE_MIN_HEALTH_FACTOR=1.6
AAVE_WARN_HEALTH_FACTOR=1.8

# トレード間のクールダウン（秒）
AAVE_TRADE_COOLDOWN_SECONDS=600

# 動作モード: NORMAL / SAFE_MODE / HARD_STOP
AAVE_OPERATION_MODE=NORMAL

# =============================================================================
# state.json 設定
# =============================================================================

# state.json のパス
AAVE_STATE_FILE_PATH=/var/run/ultra/state.json

# state.json の stale 判定しきい値（秒）
AAVE_STATE_STALE_THRESHOLD_SECONDS=300

# =============================================================================
# クライアント選択
# =============================================================================

# 本番は必ず web3 を使用
AAVE_CLIENT_TYPE=web3

# =============================================================================
# OctoBot (シグナル API)
# =============================================================================

# 本番 OctoBot インスタンスの Base URL
OCTOBOT_API_BASE_URL=https://octobot.example.com/api

# 本番 OctoBot 用 API キー
OCTOBOT_API_KEY=octo_prod_xxx

# OctoBot API 呼び出しのタイムアウト（秒）
OCTOBOT_TIMEOUT_SECONDS=10

# =============================================================================
# Notion 連携
# =============================================================================

# 本番 Notion API キー
NOTION_API_KEY=secret_prod_xxx

# 本番で運用する Notion データベース ID
NOTION_DATABASE_ID=xxxx-yyyy-zzzz-aaaa

# Notion API 設定（通常は変更不要）
NOTION_API_BASE_URL=https://api.notion.com
NOTION_API_VERSION=2022-06-28

# =============================================================================
# 通知設定
# =============================================================================

# LINE Notify
LINE_NOTIFY_TOKEN=
LINE_NOTIFY_ENABLED=true

# Slack
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz
SLACK_CHANNEL=#ultra-autotrade-alerts
SLACK_ENABLED=true

# デフォルト通知チャンネル: line / slack / email / internal_log
DEFAULT_NOTIFICATION_CHANNEL=line

# =============================================================================
# バックグラウンド監視・レポート
# =============================================================================

# バックグラウンド監視の有効化
ENABLE_BACKGROUND_MONITORING=true
MONITORING_INTERVAL_SECONDS=60

# 日次レポートの有効化
ENABLE_DAILY_REPORTS=true

# 週次レポートの有効化
ENABLE_WEEKLY_REPORTS=true

# レポートのタイムゾーン
REPORT_TIMEZONE=Asia/Tokyo

# =============================================================================
# 監視・メトリクス
# =============================================================================

# ヘルスチェック URL
MONITOR_HEALTHCHECK_URL=http://localhost:8000/health

# レイテンシ警告しきい値（ミリ秒）
MONITOR_WARN_MS=1000

# レイテンシアラートしきい値（ミリ秒）
MONITOR_ALERT_MS=30000

# メトリクスログディレクトリ
METRICS_LOG_DIR=/var/log/ultra

# 監視通知チャンネル名
MONITOR_NOTIFY_CHANNEL=production-monitoring

# =============================================================================
# AI / LLM クライアント（必要に応じて）
# =============================================================================

# OpenAI API キー
# OPENAI_API_KEY=sk-xxx

# OpenAI モデル名
# OPENAI_MODEL=gpt-4.1

# =============================================================================
# E2E テスト（本番環境では無効化）
# =============================================================================

# E2E テストフラグ（本番では必ず 0）
RUN_E2E_TESTS=0
